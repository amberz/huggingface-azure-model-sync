# Shared settings for all scripts. Edit before running.
# Every value can be overridden by an environment variable of the same name
# (the web UI in ui/ uses this to pass its selections).

# Leave empty to use the current `az account show` subscription.
SUBSCRIPTION_ID="${SUBSCRIPTION_ID-9f52431b-de05-48c0-be2a-f0eda15ca4fa}"  # Azure Storage Learning Sub 1
# Region for the resource group and storage account.
LOCATION="${LOCATION:-eastus}"
RESOURCE_GROUP="${RESOURCE_GROUP:-rg-hf-model-sync}"

# Must be globally unique, 3-24 lowercase letters/digits.
# Leave empty to auto-generate one (persisted in .state.env).
STORAGE_ACCOUNT="${STORAGE_ACCOUNT:-}"
BLOB_CONTAINER="${BLOB_CONTAINER:-hf-models}"

IDENTITY_NAME="${IDENTITY_NAME:-id-hf-trainer}"
ACI_NAME="${ACI_NAME:-aci-hf-trainer}"
# Region for the container instance and its managed identity.
ACI_LOCATION="${ACI_LOCATION:-$LOCATION}"
ACI_IMAGE="${ACI_IMAGE:-mcr.microsoft.com/devcontainers/python:3.11}"
ACI_CPU="${ACI_CPU:-4}"
ACI_MEMORY_GB="${ACI_MEMORY_GB:-16}"

# Training job
HF_MODEL_ID="${HF_MODEL_ID:-distilbert-base-uncased}"
RUN_ID="${RUN_ID:-run-001}"
MAX_STEPS="${MAX_STEPS:-200}"
SAVE_STEPS="${SAVE_STEPS:-50}"
TRAIN_SAMPLES="${TRAIN_SAMPLES:-4000}"
